      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Oceanography: General: Numerical modeling; Oceanography: General: Limnology; Oceanography: Physical: Turbulence, diffusion, and mixing processes; Oceanography: Biological and Chemical: Hypoxic environments</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A coupled bubble plume&amp;#8211;reservoir model for hypolimnetic oxygenation</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>V. L. Singleton, F. J. Rueda, J. C. Little</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
      <rdf:Description rdf:about="" xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>http://dx.doi.org/10.1029/2009WR009012, doi:10.1029/2009WR009012, hypolimnetic oxygenation, hypolimnetic aeration, model coupling, bubble plum, oxygen transfer, line diffuser</pdf:Keywords>
